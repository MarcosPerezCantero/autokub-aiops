{
  "mode": "execute",
  "namespaces": {
    "otel-demo": {
      "targets": [
        "ad",
        "cart",
        "checkout",
        "currency",
        "email",
        "frontend",
        "payment",
        "product-catalog",
        "quote",
        "recommendation",
        "shipping"
      ]
    }
  },
  "limits": {
    "max_actions_per_hour": 3,
    "max_memory_bytes": 536870912
  },
  "detection": {
    "poll_seconds": 5,
    "min_restarts": 2,
    "stable_seconds": 30,
    "verify_timeout_seconds": 120,
    "max_attempts": 2,
    "clear_seconds": 60
  }
}
